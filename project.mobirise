            ".row": {
              "margin": "0",
              ".title-wrapper": {
                ".mbr-section-title": {
                  "margin-bottom": "50px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "32px"
                  }
                }
              },
              ".panel-group": {
                ".card": {
                  "border-bottom": "1px solid @border",
                  "border-radius": "0 !important",
                  "&:first-child": {
                    "border-top": "1px solid @border"
                  },
                  ".card-header": {
                    "padding": "32px 0",
                    "border-bottom": "none",
